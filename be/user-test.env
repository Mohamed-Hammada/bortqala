# ========================================================
# Bemo ERP Backend - DEV Environment
# ========================================================

# Spring
SPRING_PROFILES_ACTIVE=dev

# Database
DB_URL=jdbc:postgresql://localhost:5432/bemo_erp_dev
DB_USERNAME=root
DB_PASSWORD=root

# CORS
HR_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://app.eysawy.dpdns.org

# Proxy / Forwarded Headers
SERVER_FORWARD_HEADERS_STRATEGY=framework

# Bootstrap Application
HR_BOOTSTRAP_APP_CODE=DEMO
HR_BOOTSTRAP_APP_NAME=Bemo ERP

# Bootstrap Admin
HR_BOOTSTRAP_ADMIN_USERNAME=admin
HR_BOOTSTRAP_ADMIN_PASSWORD=Admin@12345

# Bootstrap Super Admin
HR_BOOTSTRAP_SUPER_ADMIN_USERNAME=superadmin
HR_BOOTSTRAP_SUPER_ADMIN_PASSWORD=SuperSameh@12345

# JWT
HR_JWT_SECRET=local-development-jwt-secret-key-32bytes-minimum

# Device Credentials
HR_DEVICE_CREDENTIALS_SECRET=ZGV2aWNlLWNyZWRlbnRpYWxzLTMyLWJ5dGVzLWtleSE=

# ========================================================
# Web Push
# ========================================================

HR_WEB_PUSH_ENABLED=true
HR_WEB_PUSH_PUBLIC_KEY=BGMHGzdrTGM-gl0Mz9N3Vxa4ikgTuVpBkuRtliKK135FS-TYaCGmUzMSSpfgt4womxH-In5uo9dhg8NowHPBp9c
HR_WEB_PUSH_PRIVATE_KEY=jdl2o2sjy6-fXiu4RqynsTTdnfjwbFYbQibGokehV10
HR_WEB_PUSH_SUBJECT=mailto:admin@bemo-erp.local
HR_WEB_PUSH_TTL_SECONDS=86400

# ========================================================
# Demo No-Login SUPER_ADMIN
# ========================================================

HR_DEMO_NO_LOGIN_ENABLED=true
HR_DEMO_NO_LOGIN_APP_CODE=DEMO
HR_DEMO_NO_LOGIN_APP_NAME=Bemo ERP
HR_DEMO_NO_LOGIN_PROFILES=dev

# Optional - leave unset to generate a random secret
# HR_DEMO_SECRET=optional-fixed-secret