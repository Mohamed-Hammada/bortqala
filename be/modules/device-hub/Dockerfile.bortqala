FROM python:3.13-slim
WORKDIR /app
COPY gateway/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY gateway/app /app/gateway/app
RUN mkdir -p /app/gateway && touch /app/gateway/__init__.py
COPY packages /app/packages
COPY docs /app/docs
COPY profiles /app/profiles
RUN mkdir -p /data
ENV DEVICE_HUB_REGISTRY_PATH=/data/devices.json
EXPOSE 8090
CMD ["uvicorn","gateway.app.main:app","--host","0.0.0.0","--port","8090"]
