{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "fe": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.scss",
              "src/ui-ux-fixes.scss"
            ]
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": {
                  "inline": false
                }
              },
              "serviceWorker": "ngsw-config.json",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "30kB",
                  "maximumError": "40kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json",
            "host": "0.0.0.0",
            "allowedHosts": [
              "sending-huntington-actions-gen.trycloudflare.com",
              ".trycloudflare.com",
              "borqala.eysawy.dpdns.org",
              "eysawy.dpdns.org",
              "localhost",
              "127.0.0.1",
              "0.0.0.0",
              "all"
            ]
          },
          "configurations": {
            "production": {
              "buildTarget": "fe:build:production"
            },
            "development": {
              "buildTarget": "fe:build:development",
              "allowedHosts": [
                "sending-huntington-actions-gen.trycloudflare.com",
                ".trycloudflare.com",
                "borqala.eysawy.dpdns.org",
                "eysawy.dpdns.org",
                "localhost",
                "127.0.0.1",
                "0.0.0.0",
                "all"
              ]
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "fe:build:development",
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "watch": false
          }
        }
      }
    }
  }
}
