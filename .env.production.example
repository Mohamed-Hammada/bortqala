# ========================================================
# BEMO ERP - PRODUCTION ENVIRONMENT (Docker Compose overlay)
# Copy to `.env` before running:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# Every value below is a required placeholder. Replace each
# CHANGE_ME with a real secret managed outside version control.
# ========================================================

# Database Credentials
POSTGRES_DB=CHANGE_ME
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# Spring Boot Backend Settings
BACKEND_PORT=8080
HR_JWT_SECRET=CHANGE_ME
HR_JWT_ISSUER=CHANGE_ME
HR_CORS_ALLOWED_ORIGINS=https://CHANGE_ME.example.com
HR_COMPANY_ZONE=Africa/Cairo
# Base64-encoded 32-byte key for biometric device credentials.
HR_DEVICE_CREDENTIALS_SECRET=CHANGE_ME

# Bootstrap accounts (created only on the first startup)
HR_BOOTSTRAP_APP_CODE=CHANGE_ME
HR_BOOTSTRAP_APP_NAME=CHANGE_ME
HR_BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME
HR_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
HR_BOOTSTRAP_SUPER_ADMIN_USERNAME=CHANGE_ME
HR_BOOTSTRAP_SUPER_ADMIN_PASSWORD=CHANGE_ME

# Angular Frontend Settings
FRONTEND_PORT=80
