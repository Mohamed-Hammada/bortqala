# ========================================================
# BEMO ERP - PRODUCTION ENVIRONMENT (Docker Compose overlay)
# Copy to `.env` before running:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# Every value below is a required placeholder. Replace each
# CHANGE_ME with a real secret managed outside version control.
# ========================================================
# Database Credentials
POSTGRES_DB=CHANGE_ME
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
# Spring Boot Backend Settings
BACKEND_PORT=8080
HR_JWT_SECRET=CHANGE_ME
HR_JWT_ISSUER=CHANGE_ME
HR_CORS_ALLOWED_ORIGINS=https://CHANGE_ME.example.com
HR_COMPANY_ZONE=Africa/Cairo
# Docker bridge subnet of the frontend reverse proxy. Match networks.internal
# in docker-compose.yml. Never set this to 0.0.0.0/0 (would allow IP spoofing).
HR_SECURITY_TRUSTED_PROXIES=10.42.0.0/24
# Base64-encoded 32-byte key for biometric device credentials.
HR_DEVICE_CREDENTIALS_SECRET=CHANGE_ME
# Bootstrap accounts (created only on the first startup)
HR_BOOTSTRAP_APP_CODE=CHANGE_ME
HR_BOOTSTRAP_APP_NAME=CHANGE_ME
HR_BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME
HR_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
HR_BOOTSTRAP_SUPER_ADMIN_USERNAME=CHANGE_ME
HR_BOOTSTRAP_SUPER_ADMIN_PASSWORD=CHANGE_ME

# Angular Frontend Settings
FRONTEND_PORT=80

# Backend device module
# Docker sets BEMO_DEVICE_HUB_BASE_URL=http://device-hub:8090
DEVICE_HUB_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Web Push (VAPID) - generate a UNIQUE production pair, for example:
#   npx web-push generate-vapid-keys
# Never reuse or commit the development/private key.
HR_WEB_PUSH_ENABLED=true
HR_WEB_PUSH_PUBLIC_KEY=CHANGE_ME
HR_WEB_PUSH_PRIVATE_KEY=CHANGE_ME
HR_WEB_PUSH_SUBJECT=mailto:admin@yourdomain.com
HR_WEB_PUSH_TTL_SECONDS=86400

# One-time entitlement backfill when using docker-deploy.*.
# A durable database marker prevents later deployments from re-enabling features
# that an administrator intentionally disabled after bootstrap.
BEMO_ENABLE_ALL_FEATURES_ON_DEPLOY=true
