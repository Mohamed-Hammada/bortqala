{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bemo HR",
  "version": "0.1.0",
  "identifier": "com.bemo.hr.desktop",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bemo HR",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/backend", "resources/runtime", "resources/postgres"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["English", "Arabic"]
      }
    }
  }
}
