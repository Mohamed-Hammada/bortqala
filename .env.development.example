# ========================================================
# BEMO ERP - DEVELOPMENT ENVIRONMENT (Docker Compose)
# Copy to `.env` before running `docker compose up`.
# Dev-only values; never use these outside local development.
# ========================================================

# Database Credentials
POSTGRES_DB=bemo_erp
POSTGRES_USER=bemo
POSTGRES_PASSWORD=bemo-dev-password
POSTGRES_PORT=5432
# Spring Boot Backend Settings
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
HR_JWT_SECRET=dev-only-jwt-secret-key-32bytes-minimum
HR_JWT_ISSUER=bemo-erp
HR_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200,https://*.trycloudflare.com,http://*.trycloudflare.com
# Base64-encoded 32-byte key for biometric device credentials (dev only).
HR_DEVICE_CREDENTIALS_SECRET=ZGV2aWNlLWNyZWRlbnRpYWxzLTMyLWJ5dGVzLWtleSE=

# Angular Frontend Settings
FRONTEND_PORT=80
# Backend device module
BEMO_DEVICE_HUB_BASE_URL=http://localhost:8090
DEVICE_HUB_API_KEY=
DEVICE_HUB_PORT=8090

# Web Push (VAPID) - DEVELOPMENT ONLY.
# Replace this pair if the development environment is reachable by real users.
HR_WEB_PUSH_ENABLED=true
HR_WEB_PUSH_PUBLIC_KEY=BGMHGzdrTGM-gl0Mz9N3Vxa4ikgTuVpBkuRtliKK135FS-TYaCGmUzMSSpfgt4womxH-In5uo9dhg8NowHPBp9c
HR_WEB_PUSH_PRIVATE_KEY=jdl2o2sjy6-fXiu4RqynsTTdnfjwbFYbQibGokehV10
HR_WEB_PUSH_SUBJECT=mailto:admin@bemo-erp.local
HR_WEB_PUSH_TTL_SECONDS=86400

# One-time entitlement backfill used by docker-deploy.*.
# The SQL stores a database marker, so later deploys do not overwrite admin changes.
BEMO_ENABLE_ALL_FEATURES_ON_DEPLOY=true
